# AISDLC service configuration — VARIABLE NAMES ONLY, never values.
#
# Copy this file to `.env` and fill the values in locally. `.env` is
# gitignored and must stay that way. Every variable below is read from the
# environment with NO literal fallback: if one is missing the service refuses
# to start and names the variable (never the value).
#
# Variables are grouped by the phase that first needs them, so a Phase 0
# checkout only has to fill in the first group.

# ── Phase 0: runtime ─────────────────────────────────────────────────────────
# Atlas SRV string for the least-privilege APPLICATION user (aisdlc_app).
# Format: mongodb+srv://<user>:<password>@<cluster-host>/aisdlc?retryWrites=true&w=majority
AISDLC_MONGODB_URI=
AISDLC_PORT=
NODE_ENV=

# ── Phase 0: deploy only ─────────────────────────────────────────────────────
# Atlas SRV string for the MIGRATION user (aisdlc_migrator), which may create
# collections, indexes and validators. Used by the one-off index/validator
# setup step ONLY — the running service never loads this variable, so that a
# compromised service cannot alter the auditLog validator.
AISDLC_MONGODB_MIGRATION_URI=

# ── Phase 3+: inbound webhook ────────────────────────────────────────────────
# Shared secret Neutara signs issue.created payloads with (HMAC-SHA256 over the
# raw body, sent as X-Neutara-Signature: sha256=<hex>). If this is unset the
# /ingest endpoint refuses every request rather than accepting unsigned ones.
NEUTARA_WEBHOOK_SECRET=

# ── Phase 4+: outbound calls to Neutara ──────────────────────────────────────
# Base URL of the Neutara API, and an `nta_` personal API token belonging to a
# dedicated service user with the `agent` role. Read-only use through Phase 7;
# write scope is granted at Phase 8 and not before.
NEUTARA_API_BASE_URL=
NEUTARA_API_TOKEN=

# ── Phase 6+: human approval gate ────────────────────────────────────────────
# Credential required to approve or reject an intake item. Deliberately
# separate from NEUTARA_API_TOKEN and never loaded by the worker process, so
# the pipeline agent cannot approve its own run.
OPERATOR_TOKEN=

# ── Phase 7+: pipeline runtime ───────────────────────────────────────────────
# Used by the Claude Agent SDK in the worker process.
ANTHROPIC_API_KEY=
