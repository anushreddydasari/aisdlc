# AISDLC service configuration — VARIABLE NAMES ONLY, never values.
#
# Copy this file to `.env` and fill the values in locally. `.env` is
# gitignored and must stay that way. Every variable below is read from the
# environment with NO literal fallback: if one is missing the service refuses
# to start and names the variable (never the value).
#
# Variables are grouped by the phase that first needs them, so a Phase 0
# checkout only has to fill in the first group.

# ── Phase 0: runtime ─────────────────────────────────────────────────────────
# Atlas SRV string for the least-privilege APPLICATION user (aisdlc_app).
# Format: mongodb+srv://<user>:<password>@<cluster-host>/aisdlc?retryWrites=true&w=majority
# Its Atlas role is scoped ONLY to the `aisdlc` database — see docs/atlas-roles.md.
# Read outside production too (only to prove a test credential below isn't
# reusing this identity); never used to connect outside production.
AISDLC_MONGODB_URI=
AISDLC_PORT=
NODE_ENV=

# ── Phase 0: deploy only ─────────────────────────────────────────────────────
# Atlas SRV string for the MIGRATION user (aisdlc_migrator), which may create
# collections, indexes and validators. Used by the one-off index/validator
# setup step ONLY — the running service never loads this variable, so that a
# compromised service cannot alter the auditLog validator.
AISDLC_MONGODB_MIGRATION_URI=

# ── Local/test only: REQUIRED when NODE_ENV is development or test ──────────
# There is no default outside production, by design — see resolveDatabaseName
# and resolveRuntimeMongoUri in src/config/env.ts.

# Which database this run targets. Refused if it names the production database.
AISDLC_DATABASE_NAME=

# A DEDICATED test-tier Atlas user (e.g. aisdlc-test-app), scoped ONLY to
# AISDLC_TEST_DATABASE below via its own role (aisdlcTestAppRole — see
# docs/atlas-roles.md). Startup refuses to run outside production if this is
# identical to, or authenticates as the same identity as, AISDLC_MONGODB_URI —
# that credential's role does not grant access to the test database at all.
AISDLC_TEST_MONGODB_URI=

# The test-tier migration user (e.g. aisdlc-test-migrator). Used only by
# `npm run db:init:test`.
AISDLC_TEST_MONGODB_MIGRATION_URI=

# The test database name — not the production one. Used by
# `npm run test:integration` and `npm run db:init:test`.
AISDLC_TEST_DATABASE=

# ── Phase 3+: inbound webhook ────────────────────────────────────────────────
# Shared secret Neutara signs issue.created payloads with (HMAC-SHA256 over the
# raw body, sent as X-Neutara-Signature: sha256=<hex>). If this is unset the
# /ingest endpoint refuses every request rather than accepting unsigned ones.
NEUTARA_WEBHOOK_SECRET=

# ── Phase 4+: outbound calls to Neutara ──────────────────────────────────────
# Base URL of the Neutara API, and an `nta_` personal API token belonging to a
# dedicated service user with the `agent` role. Read-only use through Phase 7;
# write scope is granted at Phase 8 and not before.
NEUTARA_API_BASE_URL=
NEUTARA_API_TOKEN=

# ── Phase 6+: human approval gate ────────────────────────────────────────────
# Bearer token required on POST /intake/:issueKey/approve and /reject
# (Authorization: Bearer <this value>). Deliberately separate from
# NEUTARA_API_TOKEN and never loaded by the enrichment loop or any future
# pipeline worker, so an automated agent cannot approve its own run. Unset
# means those two endpoints answer 401 to every request rather than the
# service refusing to start — see README.md's Approval gate section.
OPERATOR_TOKEN=

# ── Phase 5+: Requirements Agent LLM analysis (also used by later phases) ────
# Optional — absent is a valid state: the Requirements Agent falls back to its
# deterministic stub analyzer rather than refusing to run (see
# loadOpenAiConfig in src/config/env.ts). Setting this opts a local run into a
# real call to the OpenAI Chat Completions API — real network access, real
# cost, and ticket content leaves the machine. Never used by npm test, which
# stays network-free regardless of whether this is set.
OPENAI_API_KEY=
# Defaults to gpt-4.1 if unset.
OPENAI_MODEL=
